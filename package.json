{
  "name": "porida",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev:web": "bun --filter ./apps/web dev",
    "dev:api": "dotnet run --project apps/api --launch-profile http",
    "build:web": "bun --filter ./apps/web build",
    "build:api": "dotnet build",
    "lint:web": "bun --filter ./apps/web lint",
    "lint:api": "dotnet format Porida.slnx --verify-no-changes"
  },
  "workspaces": [
    "apps/web"
  ]
}